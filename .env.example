# ==============================================================================
# BhuSetu 3D: PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Team: TANTRAKATHA | Smart India Hackathon 2026 (SIH26011)
# Phase 14: Production Deployment + Security + Performance Hardening
#
# MANDATORY SECURITY PRINCIPLES:
# 1. Supabase PostgreSQL 16 + PostGIS 3.4 is the SOLE database platform.
# 2. Never commit real passwords, service-role keys, or JWT secrets to Git.
# 3. Only NEXT_PUBLIC_* variables may be bundled into the browser client.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME & ENVIRONMENT CLASSIFICATION
# ------------------------------------------------------------------------------
ENVIRONMENT=production
NODE_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (Never expose to client or commit to repository)
# ------------------------------------------------------------------------------
# Database URL with SSL enabled (Supabase managed PostgreSQL + PostGIS)
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-STRONG-PASSWORD]@db.qcobqjtrhhdwzmadfykq.supabase.co:5432/postgres?ssl=require

# Supabase Project Credentials
SUPABASE_URL=https://qcobqjtrhhdwzmadfykq.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_lCZMVQiaV9X-GnUjdYx-TA_2iHm3AHp
# Optional: Supabase JWT Secret for direct HMAC-SHA256 signature verification
SUPABASE_JWT_SECRET=

# Gemini AI Spatial Investigator API Key (Server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Application Secret Key (Used for session / HMAC signatures)
SECRET_KEY=

# ------------------------------------------------------------------------------
# 3. API OPERATIONAL LIMITS & NETWORK SECURITY
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["https://bhusetu3d.gov.in"]
MAX_REQUEST_SIZE_BYTES=52428800
RATE_LIMIT_ENABLED=true
REQUEST_TIMEOUT_SECONDS=60

# ------------------------------------------------------------------------------
# 4. NEXT.JS PUBLIC CLIENT VARIABLES (Safe for browser delivery)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://qcobqjtrhhdwzmadfykq.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_lCZMVQiaV9X-GnUjdYx-TA_2iHm3AHp
NEXT_PUBLIC_API_URL=https://bhusetu3d-backend.onrender.com/api/v1

