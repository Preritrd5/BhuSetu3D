# Multi-stage Dockerfile for BhuSetu 3D FastAPI Backend
# Team: TANTRAKATHA | SIH 2026 (SIH26011)
# Phase 14: Production Deployment + Security + Performance Hardening

FROM python:3.11-slim as builder

WORKDIR /app

# Install system build dependencies for C-extensions (GEOS, GDAL prerequisites)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies
COPY apps/api/requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# Final production runtime image
FROM python:3.11-slim as runner

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root system user for container security
RUN groupadd -g 10001 appgroup && \
    useradd -u 10001 -g appgroup -m -s /bin/bash appuser

# Copy installed python packages from builder
COPY --from=builder /root/.local /home/appuser/.local
ENV PATH=/home/appuser/.local/bin:$PATH
ENV PYTHONUNBUFFERED=1
ENV ENVIRONMENT=production

# Copy backend source code and set ownership
COPY --chown=appuser:appgroup apps/api/app ./app
COPY --chown=appuser:appgroup apps/api/pyproject.toml .

USER appuser

EXPOSE 8000

# Healthcheck probe using liveness probe
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/api/v1/health/live || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2", "--no-access-log"]
